{
  "name": "settle-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "pnpm --filter settle-web start",
    "dev": "pnpm --filter settle-web dev",
    "dev:api": "pnpm --filter settle-api start:dev",
    "dev:mobile": "pnpm --filter settle-mobile start",
    "build": "pnpm --filter settle-web build",
    "build:shared-sdk": "pnpm --filter @settle/shared-sdk build",
    "build:shared": "pnpm --filter @settle/shared build",
    "build:web": "pnpm --filter settle-web build",
    "build:api": "pnpm --filter settle-api build",
    "build:mobile": "pnpm --filter settle-mobile build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,.js,.jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,.js,.jsx,json,md}\"",
    "clean:mac-files": "find . -name '._*' -type f -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/.next/*' -delete",
    "configure:macos": "./scripts/configure-macos.sh",
    "install:hooks": "./scripts/install-hooks.sh",
    "self-heal": "bash scripts/quick-fix.sh",
    "fix-all": "bash scripts/quick-fix.sh",
    "check-all": "bash scripts/quick-fix.sh",
    "watch:errors": "node scripts/watch-errors.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.1",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "playwright-core": "^1.49.0"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "shell-quote": ">=1.11.0",
      "@grpc/grpc-js": ">=1.14.5",
      "axios": ">=1.20.0",
      "browserslist": ">=4.28.7",
      "fast-uri": ">=3.1.8",
      "multer": ">=2.3.0",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "qs": ">=6.16.0",
      "baseline-browser-mapping": ">=2.11.0",
      "uuid": ">=11.1.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@3": "^5.0.12",
      "brace-expansion@>=4.0.0": "^5.0.12",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": ">=3.3.18",
      "undici@7": ">=7.29.1"
    }
  }
}
