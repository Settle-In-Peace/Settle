# Database
DATABASE_URL=postgresql://user:password@localhost:5432/settle

# Auth
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# App URLs
FRONTEND_URL=http://localhost:3025
NEXT_PUBLIC_APP_URL=http://localhost:3025
CORS_ORIGINS=http://localhost:3025,https://settleinpeace.com
PORT=4025

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@settleinpeace.com
SUPPORT_EMAIL=support@settleinpeace.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Product/Price IDs - create these in your Stripe dashboard
STRIPE_COACHING_PRICE_ID=price_xxx
STRIPE_COACHING_PRODUCT_NAME="Monthly Coaching Subscription"
STRIPE_PRICE_PROVIDER_STARTER=price_xxx
STRIPE_PRICE_PROVIDER_GROWTH=price_xxx
STRIPE_PRICE_PROVIDER_SCALE=price_xxx

# SMS (Telnyx)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# Firebase Admin (service account JSON on a single line)
FIREBASE_SERVICE_ACCOUNT=

# AI / OpenAI
OPENAI_API_KEY=

# MyFreeScoreNow (credit bureau)
# MFSN_ENV selects the default base URL:
#   sandbox    -> https://uat-api.myfreescorenow.com
#   production -> https://api.myfreescorenow.com  (requires verification-docs approval)
# MFSN_API_BASE_URL overrides it entirely if set.
MFSN_ENV=sandbox
MFSN_API_BASE_URL=https://uat-api.myfreescorenow.com
# API user + password from the MyFreeScoreNow affiliate dashboard
# (MFSN_API_EMAIL is accepted as a legacy alias for MFSN_API_USER)
MFSN_API_USER=
MFSN_API_EMAIL=
MFSN_API_PASSWORD=
# Resilience tuning (optional)
# MFSN_TIMEOUT_MS=15000
# MFSN_MAX_RETRIES=2
# Endpoint paths — update once MyFreeScoreNow provides full API docs
# MFSN_LOGIN_PATH=/api/auth/login
# MFSN_CREDIT_SNAPSHOT_PATH=/api/credit-snapshot
# MFSN_FUNDING_SNAPSHOT_PATH=/api/funding-snapshot
# MFSN_3B_REPORT_PATH=/api/3b-reports

# Matching
AUTO_MATCH_THRESHOLD=70

# Node environment
NODE_ENV=development
