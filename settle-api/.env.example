# Database
DATABASE_URL=postgresql://user:password@localhost:5432/settle

# Auth
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret

# App URLs
FRONTEND_URL=http://localhost:3025
NEXT_PUBLIC_APP_URL=http://localhost:3025
CORS_ORIGINS=http://localhost:3025,https://settleinpeace.com
PORT=4025

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@settleinpeace.com
SUPPORT_EMAIL=support@settleinpeace.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Product/Price IDs - create these in your Stripe dashboard
STRIPE_COACHING_PRICE_ID=price_xxx
STRIPE_COACHING_PRODUCT_NAME="Monthly Coaching Subscription"
STRIPE_PRICE_PROVIDER_STARTER=price_xxx
STRIPE_PRICE_PROVIDER_GROWTH=price_xxx
STRIPE_PRICE_PROVIDER_SCALE=price_xxx

# SMS (Telnyx)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# Firebase Admin (service account JSON on a single line)
FIREBASE_SERVICE_ACCOUNT=

# AI / OpenAI-compatible LLM (powers /ai/* assessment chat AND /collection-ai/*)
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Azure proxy,
# self-hosted vLLM/Ollama with an OpenAI shim, etc.
#   AI_BASE_URL — default https://api.openai.com/v1
#   AI_API_KEY  — preferred; falls back to OPENAI_API_KEY
#   AI_MODEL    — default gpt-4o-mini
# Without a key, /collection-ai/* returns 503 and /ai/chat replies with a
# friendly fallback — nothing else breaks.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=20000      per-attempt request timeout
# AI_MAX_RETRIES=2         retries on network errors, 429, and 5xx
# AI_CACHE_TTL_MS=60000    in-memory cache for identical /collection-ai requests

# MyFreeScoreNow (credit bureau)
# MFSN_ENV selects the default base URL:
#   sandbox    -> https://uat-api.myfreescorenow.com
#   production -> https://api.myfreescorenow.com  (requires verification-docs approval)
# MFSN_API_BASE_URL overrides it entirely if set.
MFSN_ENV=sandbox
MFSN_API_BASE_URL=https://uat-api.myfreescorenow.com
# API user + password from the MyFreeScoreNow affiliate dashboard
# (MFSN_API_EMAIL is accepted as a legacy alias for MFSN_API_USER)
MFSN_API_USER=
MFSN_API_EMAIL=
MFSN_API_PASSWORD=
# Resilience tuning (optional)
# MFSN_TIMEOUT_MS=15000
# MFSN_MAX_RETRIES=2
# Endpoint paths — update once MyFreeScoreNow provides full API docs
# MFSN_LOGIN_PATH=/api/auth/login
# MFSN_CREDIT_SNAPSHOT_PATH=/api/credit-snapshot
# MFSN_FUNDING_SNAPSHOT_PATH=/api/funding-snapshot
# MFSN_3B_REPORT_PATH=/api/3b-reports

# Matching
AUTO_MATCH_THRESHOLD=70

# ── Lead vendors (ping/post purchase + webhook/CSV import) ─────────────
# Comma-separated vendor names enabled via env. For each <NAME>:
#   LEADVENDOR_<NAME>_PING_URL        ping endpoint (criteria -> bid/price)
#   LEADVENDOR_<NAME>_POST_URL        post endpoint (full lead -> accept/reject)
#   LEADVENDOR_<NAME>_ORDER_URL       bulk order endpoint (defaults to POST_URL)
#   LEADVENDOR_<NAME>_KEY             API key (or _API_KEY)
#   LEADVENDOR_<NAME>_AUTH            bearer | header | param | none (default bearer)
#   LEADVENDOR_<NAME>_AUTH_HEADER     header name when AUTH=header (default x-api-key)
#   LEADVENDOR_<NAME>_AUTH_PARAM      param name when AUTH=param (default api_key)
#   LEADVENDOR_<NAME>_FORMAT          form | json (default form — boberdoo/LeadsPedia/LeadProsper style)
#   LEADVENDOR_<NAME>_FIELD_MAP       JSON {ourField: vendorField} renames
#   LEADVENDOR_<NAME>_BASE_PRICE      static per-lead price (no ping)
#   LEADVENDOR_<NAME>_WEBHOOK_SECRET  HMAC secret for inbound webhook posts
#   LEADVENDOR_<NAME>_TIMEOUT_MS / _MAX_RETRIES
LEADVENDOR_NAMES=
# LEADVENDOR_BOBERDOO_PING_URL=https://leads.boberdoo.com/…/ping.php
# LEADVENDOR_BOBERDOO_POST_URL=https://leads.boberdoo.com/…/post.php
# LEADVENDOR_BOBERDOO_KEY=
# LEADVENDOR_BOBERDOO_WEBHOOK_SECRET=
# Alternative: full vendor config as a JSON array
# LEADVENDORS_CONFIG='[{"name":"leadsprosper","pingUrl":"…","postUrl":"…","authStyle":"param","format":"form"}]'
# Comma-separated USPS codes; default = all US states + DC
# LEAD_SCORING_LICENSED_STATES=CA,TX,FL,NY

# ── High-risk payment processors (debt collection MCC — NOT Stripe) ──────
# Failover order; unknown/unconfigured names are skipped.
PAYMENT_PROCESSOR_PRIORITY=nmi,authorizenet,stripe
#
# NMI (Network Merchants Inc) — gateway behind most collection merchant
# accounts. Keys: merchant portal → Settings → Security Keys.
#   sandbox    -> https://sandbox.nmi.com  (test merchant account)
#   production -> https://secure.nmi.com
# NMI_API_BASE_URL overrides the env-derived base URL entirely.
NMI_ENV=sandbox
NMI_SECURITY_KEY=
NMI_PUBLIC_KEY=        # Collect.js public tokenization key (safe for browser)
NMI_WEBHOOK_SECRET=    # Settings → Webhooks signing key (verifies Webhook-Signature)
# NMI_API_BASE_URL=
# NMI_TIMEOUT_MS=15000
# NMI_MAX_RETRIES=2
#
# Authorize.Net — second high-risk-friendly option (Accept.js tokenization).
#   sandbox    -> https://apitest.authorize.net  (sandbox.authorize.net acct)
#   production -> https://api.authorize.net
AUTHNET_ENV=sandbox
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_CLIENT_KEY=    # Accept.js public client key (safe for browser)
AUTHNET_SIGNATURE_KEY= # webhook HMAC-SHA512 key (X-ANET-SIGNATURE)
# AUTHNET_API_BASE_URL=
# AUTHNET_TIMEOUT_MS=15000
# AUTHNET_MAX_RETRIES=2
# Stripe fallback in the router reuses STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET
# (+ STRIPE_PUBLISHABLE_KEY for hosted fields) — only if Stripe boards you.

# Node environment
NODE_ENV=development

# Dialer (outbound calls — provider selected by DIALER_PROVIDER: vicidial|telnyx)
# Default is vicidial (free/open-source, self-hosted). telnyx is paid — only
# set it when a Telnyx Call Control budget exists.
DIALER_PROVIDER=vicidial
# Telnyx Call Control — reuses TELNYX_API_KEY / TELNYX_FROM_NUMBER above
TELNYX_CONNECTION_ID=
# TELNYX_PUBLIC_KEY — Ed25519 key for /dialer/webhooks/telnyx signature checks
# TELNYX_CALL_WEBHOOK_URL — override; defaults to PUBLIC_API_URL + /dialer/webhooks/telnyx
# PUBLIC_API_URL=
# ViciDial Non-Agent API (free/self-hosted dialer)
VICIDIAL_BASE_URL=
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
VICIDIAL_AGENT_USER=
# VICIDIAL_SOURCE=settle
# VICIDIAL_PHONE_CODE=1
# VICIDIAL_LIST_ID=
