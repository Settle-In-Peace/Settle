{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@settle/shared": ["./packages/shared/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
