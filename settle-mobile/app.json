{
  "expo": {
    "name": "Settle In Peace",
    "slug": "settle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "settleinpeace",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0b1526",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.settleinpeace.mobile",
      "buildNumber": "11",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Settle In Peace uses Face ID to securely unlock your account.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "webcredentials:settleinpeace.com",
        "webcredentials:www.settleinpeace.com",
        "applinks:settleinpeace.com",
        "applinks:www.settleinpeace.com"
      ]
    },
    "android": {
      "package": "com.settleinpeace.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#0b1526",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "settleinpeace.com" },
            { "scheme": "https", "host": "www.settleinpeace.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "settleinpeace" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b1526"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Settle In Peace to use Face ID."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dad6fd70-85a6-4533-be1b-af97a18eb887"
      }
    },
    "owner": "notyced"
  }
}