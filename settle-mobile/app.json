{
  "expo": {
    "name": "Settle In Peace",
    "slug": "settle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "settleinpeace",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E6F4FE",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.settleinpeace.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Settle In Peace uses Face ID to securely unlock your account.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "webcredentials:settleinpeace.com",
        "webcredentials:www.settleinpeace.com"
      ]
    },
    "android": {
      "package": "com.settleinpeace.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Settle In Peace to use Face ID."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "dad6fd70-85a6-4533-be1b-af97a18eb887"
      }
    },
    "owner": "notyced"
  }
}