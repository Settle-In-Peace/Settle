{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.settleinpeace.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.settleinpeace.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_USE_PNPM": "1",
        "EXPO_PUBLIC_API_URL": "https://api.settleinpeace.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./credentials/ios/asc-api-key.p8",
        "ascApiKeyId": "PPQQ3TLU4A",
        "ascApiKeyIssuerId": "69a6de7c-e268-47e3-e053-5b8c7c11a4d1",
        "appleTeamId": "987B9KG4M7"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}